@page
@model AddBookModel

<form method="post">
    <div class="mb-3">
        <label for="titel" class="form-label">Titel</label>
        <input type="text" class="form-control" name="titel" placeholder="Titel" id="titel">
    </div>
    <div class="mb-3">
        <label for="autor" class="form-label">Autor</label>
        <input type="text" class="form-control" name="autor" id="autor" placeholder="Autor">
    </div>
    <div class="mb-3">
        <label for="genre" class="form-label">Genre</label>
        <select name="genre" id="genre" class="form-control">
            @foreach(var genre in Model.Genres) {
                <option value="@genre.Id">@genre.Bezeichnung</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <input class="btn btn-primary mb-3" type="submit" value="Erstellen">
    </div>
</form>