@page
@model ListBooksModel

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Titel</th>
            <th>Autor</th>
            <th>Ausgeliehen</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var buch in Model.Bücher) {
            <tr>
                <td>@buch.Id</td>
                <td><a asp-page="/ShowBook" asp-route-id="@buch.Id">@buch.Titel</a></td>
                <td>@buch.Autor</td>
                <td><input type="checkbox" disabled @(@buch.IsAusgeliehen ? "checked" : "")></td>
            </tr>
        }
    </tbody>
</table>