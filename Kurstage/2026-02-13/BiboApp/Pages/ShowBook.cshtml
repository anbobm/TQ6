@page
@model ShowBookModel

<h1>Detailansicht</h1>
@if(Model.Buch == null) {
    <p>Das Buch wurde nicht gefunden.</p>
}
else{
    <p>Id: @Model.Buch.Id</p>
    <p>Titel: @Model.Buch.Titel</p>
    <p>Autor: @Model.Buch.Autor</p>
    <p>Genre: @Model.Buch.Genre.Bezeichnung</p>
    <p>Ausgeliehen: @(Model.Buch.IsAusgeliehen ? "Ja" : "Nein")</p>
    if(Model.Buch.IsAusgeliehen)
    {
        <p>Ausgeliehen von NutzerID:
            <a asp-page="/ShowUser"
                asp-route-id="@Model.Buch.Ausleihender.Id">
                @Model.Buch.Ausleihender.Email
            </a>
        </p>
    }
}