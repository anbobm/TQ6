@page
@model NeuesWebProjekt.Pages.AddBooksModel

<h1>Neues Buch hinzufügen</h1>

<form method="post">
    <div>
        <label>Titel:</label>
        <input asp-for="NeuesBuch.Titel" />
    </div>

    <div>
        <label>Autor:</label>
        <input asp-for="NeuesBuch.Autor" />
    </div>

    <div>
        <label>
            <input asp-for="NeuesBuch.IsAusgeliehen" />
            Ist ausgeliehen
        </label>
    </div>

    <button type="submit">Speichern</button>
</form>

<br />

<a href="/ListBooks">Zurück zur Liste</a>