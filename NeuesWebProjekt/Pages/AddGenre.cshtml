@page
@model BiboApp.Pages.AddGenreModel

<h1>Neues Genre hinzufügen</h1>

<form method="post">
    <div>
        <label>Bezeichnung:</label>
        <input asp-for="NeuesGenre.Bezeichnung" />
        <span asp-validation-for="NeuesGenre.Bezeichnung" style="color:red"></span>
    </div>

    <button type="submit">Speichern</button>
</form>

<br />

<a asp-page="/ListGenres">Zurück zur Liste</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}