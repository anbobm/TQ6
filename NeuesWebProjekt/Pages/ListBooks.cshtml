@page
@model NeuesWebProjekt.Pages.ListBooksModel

<h1>Alle Bücher</h1>

<table border="0">
    <thead>
        <tr>
            <th>ID</th>
            <th>Titel</th>
            <th>Autor</th>
            <th>Ausgeliehen</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var buch in Model.Buecher)
        {
            <tr>
                <td>@buch.Id</td>
                <td>
                    <a asp-page="/ShowBook" asp-route-id="@buch.Id">
                        @buch.Titel
                    </a>
                </td>
                <td>@buch.Autor</td>
                <td>@(buch.IsAusgeliehen ? "Ja" : "Nein")</td>
            </tr>
        }
    </tbody>
</table>