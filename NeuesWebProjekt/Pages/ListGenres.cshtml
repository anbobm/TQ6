@page
@model BiboApp.Pages.ListGenresModel

<h1>Alle Genres</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Bezeichnung</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var genre in Model.Genres)
        {
            <tr>
                <td>@genre.Id</td>
                <td>@genre.Bezeichnung</td>
            </tr>
        }
    </tbody>
</table>

<br />

<a asp-page="/AddGenre">Neues Genre hinzufügen</a>