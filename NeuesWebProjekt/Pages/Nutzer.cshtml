@page
@model BiboApp.Pages.NutzerModel

<h1>Alle Nutzer</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Email</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var nutzer in Model.NutzerListe)
        {
            <tr>
                <td>@nutzer.Id</td>
                <td>
                    <a asp-page="/ShowNutzer" asp-route-id="@nutzer.Id">
                        @nutzer.Email
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>