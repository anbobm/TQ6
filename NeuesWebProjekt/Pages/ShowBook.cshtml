@page
@model BiboApp.Pages.ShowBookModel

@if (Model.Buch == null)
{
    <h1>Buch nicht gefunden</h1>
}
else
{
    <h1>@Model.Buch.Titel</h1>

    <div>
        <p><strong>ID:</strong> @Model.Buch.Id</p>
        @* <p><strong>Titel:</strong> @Model.Buch.Titel</p> *@
        <p><strong>Autor:</strong> @Model.Buch.Autor</p>
        <p><strong>Genre:</strong> @Model.Buch.GenreNavigation?.Bezeichnung</p>
        <p><strong>Ausgeliehen:</strong> @(Model.Buch.IsAusgeliehen ? "Ja" : "Nein")</p>

        @if (Model.Buch.Ausleihender != null)
        {
            <p>Ausgeliehen von Nutzer ID: @Model.Buch.Ausleihender.Id</p>
        }
        else
        {
            <p>Nicht ausgeliehen</p>
        }
    </div>

    <br />
    <a asp-page="/ListBooks">Zurück zur Liste</a>
}