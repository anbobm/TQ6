@page
@model Razor_Pages.Pages.AddBookModel


<h1>Buch hinzufügen</h1>

<form method="post">
    <div class="row mb-3">
    <label class="col-sm-2 col-form-label">Titel:</label>
    <div class="col-sm-4">
        <input type="text" asp-for="NeuesBuch.Titel" class="form-control" />
    </div>
    </div>

    <div class="row mb-3">
        <label class="col-sm-2 col-form-label">Autor:</label>
        <div class="col-sm-4">
            <input type="text" asp-for="NeuesBuch.Autor" class="form-control" />
        </div>
    </div>

    <div class="row mb-3">
        <label class="col-sm-2 col-form-label">Ausgeliehen:</label>
        <div class="col-sm-4">
            <div class="form-check">
                <input type="checkbox" asp-for="NeuesBuch.IsAusgeliehen" class="form-check-input" />
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Speichern</button>

</form>
