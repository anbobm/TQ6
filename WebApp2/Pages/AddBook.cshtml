@page
@model WebApp2.Pages.AddBookModel

<h1>Buch hinzufügen</h1>

<form method="post">

    <div class="row mb-3">
        <label asp-for="Titel" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-4">
            <input asp-for="Titel" class="form-control" />
        </div>
    </div>

    <div class="row mb-3">
        <label asp-for="Autor" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-4">
            <input asp-for="Autor" class="form-control" />
        </div>
    </div>


    <!-- Genre Auswahl -->
    <div class="row mb-3">
        <label asp-for="GenreId" class="col-sm-2 col-form-label">Genre</label> <!-- NEU -->
        <div class="col-sm-4">
            <select asp-for="GenreId" class="form-select" required> <!-- NEU: asp-for + required -->
                
                <option value="">-- Genre auswählen --</option> <!-- NEU: verhindert leere Auswahl -->

                @foreach (var genre in Model.Genres) 
                {
                    <option value="@genre.Id">
                        @genre.Bezeichnung
                    </option>
                }

            </select>
        </div>
    </div>


    <!-- Ausgeliehen Checkbox -->
    <div class="row mb-3">
        <label asp-for="IsAusgeliehen" class="col-sm-2 col-form-label">
            Ausgeliehen
        </label>

        <div class="col-sm-4">
            <div class="form-check">
                <input asp-for="IsAusgeliehen" class="form-check-input" />
            </div>
        </div>
    </div>


    <button type="submit" class="btn btn-primary">
        Speichern
    </button>

</form>
