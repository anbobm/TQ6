@page
@model WebApp2.Pages.ListBooksModel

<h1>Bücherliste</h1>

@if (!Model.Bücher.Any())
{
    <p>Keine Bücher passend zum Filter gefunden.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Titel</th>
                <th>Autor</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var buch in Model.Bücher)
            {
                <tr>
                    <td>@buch.Id</td>

                    <td>
                        <a asp-page="/ShowDetails" asp-route-id="@buch.Id">
                            @buch.Titel
                        </a>
                    </td>

                    <td>@buch.Autor</td>
                   
                </tr>
            }
        </tbody>
    </table>
}
